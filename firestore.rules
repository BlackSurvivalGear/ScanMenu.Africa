rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() { return request.auth != null && exists(/databases/$(database)/documents/admins/$(request.auth.uid)); }
    function isModerator() { return request.auth != null && (exists(/databases/$(database)/documents/moderators/$(request.auth.uid)) || isAdmin()); }
    function userPlan(uid) { return get(/databases/$(database)/documents/users/$(uid)).data.plan; }
    function isPaid(uid) { return userPlan(uid) == 'standard' || userPlan(uid) == 'pro'; }
    function isPremium(uid) { return userPlan(uid) == 'pro'; }

    match /admins/{adminId} {
      allow read: if request.auth != null && (request.auth.uid == adminId || isAdmin());
      allow write: if false;
    }
    match /moderators/{moderatorId} {
      allow read: if request.auth != null && (request.auth.uid == moderatorId || isAdmin());
      allow write: if isAdmin();
    }

    match /users/{userId} {
      allow read: if (request.auth != null && request.auth.uid == userId) || isModerator();
      allow create: if request.auth != null && request.auth.uid == userId
                    && (!request.resource.data.keys().hasAny(['plan']) || request.resource.data.plan == 'preview')
                    && !request.resource.data.keys().hasAny(['stripeCustomerId','stripeSubscriptionId','subscriptionStatus']);
      allow update: if (request.auth != null && request.auth.uid == userId &&
                        !request.resource.data.diff(resource.data).affectedKeys().hasAny([
                          'plan','subscriptionActivatedAt','activatedBy','subscriptionExpiry','stripeCustomerId','stripeSubscriptionId',
                          'subscriptionStatus','cancelAtPeriodEnd','subscriptionCurrentPeriodEnd','subscriptionUpdatedAt','subscriptionCancelledAt',
                          'lastInvoiceStatus','lastInvoiceAt'
                        ]))
                    || (isAdmin() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['plan','subscriptionActivatedAt','activatedBy','subscriptionExpiry']));
      allow delete: if isAdmin();
    }

    match /businesses/{uid} {
      allow read: if true;
      allow create: if request.auth != null && request.auth.uid == uid
                    && (!request.resource.data.keys().hasAny(['billingPlan']) || request.resource.data.billingPlan == 'preview')
                    && (!request.resource.data.keys().hasAny(['logoUrl']) || request.resource.data.logoUrl == '' || isPaid(uid))
                    && (!request.resource.data.keys().hasAny(['customOrderUrl']) || request.resource.data.customOrderUrl == '' || isPremium(uid));
      allow update: if (request.auth != null && request.auth.uid == uid
                        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['approved','featured','billingPlan','subscriptionStatus'])
                        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['logoUrl']) || isPaid(uid))
                        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['customOrderUrl']) || isPremium(uid)))
                    || (isModerator() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['approved','featured']));
      allow delete: if isAdmin();
    }

    match /restaurants/{uid} {
      allow read: if true;
      allow create, update: if request.auth != null && request.auth.uid == uid;
      allow delete: if isAdmin();
    }

    match /menuCategories/{categoryId} {
      allow create, update: if false;
      allow read: if true;
      allow delete: if isModerator();
    }

    match /menuItems/{itemId} {
      allow read: if true;
      // All owner mutations go through menuItemMutation Cloud Function so plan limits cannot be bypassed in the browser.
      allow create, update: if false;
      allow delete: if isModerator();
    }

    match /orders/{orderId} {
      allow create: if true;
      allow read: if (request.auth != null && resource.data.restaurantId == request.auth.uid) || isModerator();
      allow update: if (request.auth != null && resource.data.restaurantId == request.auth.uid && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','updatedAt'])) || isModerator();
      allow delete: if isAdmin();
    }
  }
}
